# Windows CPU build as XLA's own Windows CI builds (rbe_xla_windows_x86_cpu_2022
# in tensorflow.bazelrc), without the remote execution: the same toolchain
# config and platform, run locally inside the container image they are made for
# (see .github/actions/build-windows). XLA's .bazelrc imports this file.

# rbe_win_base, without rbe_base and the remote-only options.
common --config=clang_local
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --shell_executable=C:/tools/msys64/usr/bin/bash.exe
common --enable_runfiles
common --nobuild_python_zip
common --define=override_eigen_strong_inline=true

# XLA's checked-in clang-cl toolchain (LLVM, MSVC and Windows SDK of the image).
common --config=xla_windows_x86_cpu_2022

# AVX2 baseline, like JAX's avx_windows and the x86-64-v3 of the other x86 builds.
common --copt=-march=haswell
common --host_copt=-march=haswell
